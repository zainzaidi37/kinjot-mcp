{
  "name": "kinjot",
  "version": "0.1.4",
  "mcpName": "io.github.zainzaidi37/kinjot",
  "packageManager": "pnpm@9.15.9",
  "description": "Jot notes from Claude Code / Codex to Kinjot — MCP server and CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainzaidi37/kinjot-mcp.git"
  },
  "homepage": "https://kinjot.com",
  "bugs": {
    "url": "https://github.com/zainzaidi37/kinjot-mcp/issues"
  },
  "type": "module",
  "bin": {
    "kinjot": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  }
}
